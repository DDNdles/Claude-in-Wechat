{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "node \"$HOME/.weixin-global-integration/hooks/hook-ask-user.mjs\"",
            "timeout": 300,
            "type": "command"
          },
          {
            "command": "node \"$HOME/.weixin-global-integration/hooks/hook-guard.mjs\"",
            "timeout": 300,
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "node \"$HOME/.weixin-global-integration/hooks/hook-notify.mjs\"",
            "timeout": 15,
            "type": "command"
          }
        ]
      }
    ]
  }
}