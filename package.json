{
  "name": "claude-in-wechat",
  "version": "0.5.13",
  "description": "轻量化可接入微信的 Claude Code 远程管理桌面应用 — Desktop app bridging WeChat with local Claude Code for remote project management",
  "author": "Claude in WeChat",
  "license": "MIT",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node scripts/copy-preload.cjs",
    "preview": "vite preview",
    "electron:dev": "node scripts/copy-preload.cjs && concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "npm run build && electron-builder",
    "electron:build:win": "npm run build && electron-builder --win",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@types/qrcode": "^1.5.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.9",
    "lucide-react": "^0.441.0",
    "next-themes": "^0.4.6",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "recharts": "^2.12.7",
    "shadcn": "^4.14.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.5",
    "eslint": "^9.9.1",
    "postcss": "^8.4.44",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "vite": "^5.4.3",
    "vite-plugin-electron": "^0.28.7",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^2.0.5",
    "wait-on": "^8.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "build": {
    "appId": "com.claude-in-wechat.app",
    "productName": "Claude in WeChat",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "vendor/**/*"
    ],
    "extraResources": [
      {
        "from": "vendor/",
        "to": "vendor/"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Claude in WeChat",
      "license": "LICENSE"
    },
    "publish": {
      "provider": "github",
      "owner": "DDNdles",
      "repo": "Claude-in-Wechat"
    }
  },
  "keywords": [
    "claude-code",
    "wechat",
    "weixin",
    "desktop-app",
    "electron",
    "react",
    "ai",
    "project-management",
    "remote-control",
    "bridge"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/DDNdles/Claude-in-Wechat.git"
  },
  "homepage": "https://github.com/DDNdles/Claude-in-Wechat#readme"
}
