{
  "name": "weixin-global-integration",
  "version": "1.0.0",
  "description": "Global WeChat integration for Claude Code — intercept tool calls, redirect questions, and track progress via WeChat",
  "main": "lib/weixin-client.mjs",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "install": "node install.js",
